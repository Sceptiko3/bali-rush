// Bali Rush · el servidor del modo online (Cloudflare Workers + un Durable Object por sala).
// Lo despliega Cloudflare solo desde GitHub (Workers Builds, carpeta «servidor»), con `npx wrangler deploy`.
{
  "name": "bali-rush-online",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "SALA", "class_name": "Sala" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  "observability": { "enabled": true }
}
